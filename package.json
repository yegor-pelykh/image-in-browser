{
  "name": "image-in-browser",
  "version": "3.8.0",
  "description": "Package for encoding / decoding images, transforming images, applying filters, drawing primitives on images on the client side (no need for server Node.js)",
  "author": "Yegor Pelykh <yegor.dev@gmail.com>",
  "license": "MIT",
  "funding": {
    "type": "individual",
    "url": "https://github.com/yegor-pelykh/image-in-browser/blob/main/DONATE.md"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yegor-pelykh/image-in-browser"
  },
  "type": "module",
  "main": "lib/src/index.js",
  "files": [
    "lib/**/*.js",
    "lib/**/*d.ts"
  ],
  "types": "lib/src/index.d.ts",
  "keywords": [
    "convert",
    "converter",
    "browser",
    "encode",
    "decode",
    "image",
    "animation",
    "bmp",
    "gif",
    "ico",
    "jpg",
    "jpeg",
    "png",
    "pnm",
    "pbm",
    "pgm",
    "ppm",
    "psd",
    "pvr",
    "tga",
    "tif",
    "tiff",
    "webp",
    "color",
    "pixel",
    "contrast",
    "saturation",
    "brightness",
    "gamma",
    "exposure",
    "hue",
    "adjust-color",
    "billboard",
    "bleach-bypass",
    "bulge-distortion",
    "bump",
    "chromatic-aberration",
    "color-halftone",
    "color-offset",
    "convolution",
    "dither",
    "drop-shadow",
    "edge-glow",
    "emboss",
    "gaussian-blur",
    "grayscale",
    "hexagon-pixelate",
    "histogram",
    "invert",
    "luminance-threshold",
    "monochrome",
    "noise",
    "normalize",
    "pixelate",
    "palette",
    "quantize",
    "reinhard-tone-map",
    "sepia",
    "sketch",
    "smooth",
    "sobel",
    "solarize",
    "stretch-ditortion",
    "vignette",
    "circle",
    "line",
    "polygon",
    "rect",
    "fill",
    "composite",
    "crop",
    "crop-circle",
    "flip",
    "rectify",
    "resize",
    "rotate",
    "flip",
    "flip-horizontal",
    "flip-vertical",
    "trim"
  ],
  "scripts": {
    "test:color": "vitest run test/color",
    "test:draw": "vitest run test/draw",
    "test:exif": "vitest run test/exif",
    "test:filter": "vitest run test/filter",
    "test:format": "vitest run test/format",
    "test:image": "vitest run test/image",
    "test:transform": "vitest run test/transform",
    "test:all": "vitest run test",
    "format:prettier": "prettier --check \"src/**/*.{js,ts,tsx,json}\" \"test/**/*.{js,ts,tsx,json}\" \"scripts/**/*.mjs\" \".github/**/*.{yml,md}\"",
    "format:prettier-fix": "prettier --write \"src/**/*.{js,ts,tsx,json}\" \"test/**/*.{js,ts,tsx,json}\" \"scripts/**/*.mjs\" \".github/**/*.{yml,md}\" --no-error-on-unmatched-pattern",
    "format:lint": "eslint . --max-warnings=0",
    "format:lint-fix": "eslint . --fix --max-warnings=0",
    "format": "npm run format:prettier-fix && npm run format:lint-fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:prettier && npm run format:lint && npm run typecheck",
    "normalize:src": "node scripts/normalize-imports.mjs",
    "check:src-clean": "node scripts/check-src-clean.mjs",
    "clean:lib": "node scripts/clean-lib.mjs",
    "build:src-js": "tsc -p tsconfig.build.json --removeComments",
    "build:src-typings": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:src": "npm run clean:lib && npm run build:src-js && npm run build:src-typings",
    "build": "npm run normalize:src && npm run format && npm run build:src",
    "release:check": "npm run normalize:src && npm run check:src-clean && npm run verify && npm run test:all && npm run build:src",
    "prepublishOnly": "npm run release:check",
    "release": "release-it",
    "donate:qr": "node scripts/generate-donate-qr.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "qrcode": "^1.5.4",
    "release-it": "^21.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript/native": "$@typescript/native",
    "proxy-agent": "^8.0.3"
  }
}
